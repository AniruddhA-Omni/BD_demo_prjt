APP_NAME="BD Demo Project"
APP_DESCRIPTION="Local-first multi-agent document intelligence showcase"
PAGE_TITLE="Document Intelligence Demo"
MAX_FILES_PER_SESSION=50
# Ingest uploads in the background (the sidebar shows progress); false ingests inline during the upload
BACKGROUND_INGESTION=true
INGEST_WORKERS=2
# Describe images with the vision model at upload (slow) instead of on the first question about them
VISION_AT_INGESTION=false

# LLM (Ollama). Every agent falls back to deterministic behaviour when the LLM is disabled or unreachable.
ENABLE_LLM=true
OLLAMA_BASE_URL="http://localhost:11434"
OLLAMA_LLM_MODEL="gemma4:e4b"
# Multimodal model for images; empty reuses OLLAMA_LLM_MODEL
OLLAMA_VISION_MODEL=""
LLM_TEMPERATURE=0.0
LLM_TIMEOUT_SECONDS=120
LLM_NUM_CTX=8192

# LangSmith tracing: the only component that sends data off the machine
ENABLE_LANGSMITH=false
LANGCHAIN_TRACING=true
LANGCHAIN_API_KEY="XXXXXX"
LANGCHAIN_API_URL="https://api.smith.langchain.com"
LANGCHAIN_PROJECT="demo-prjt-observation"
# Hide questions/document text/answers from LangSmith; routes, counts, scores and timings are still traced
LANGSMITH_HIDE_CONTENT=false

# Dense retrieval: memory (in-process, session-only) | embedded (on-disk at QDRANT_PATH) | server (QDRANT_URL)
QDRANT_ENABLED=true
QDRANT_MODE=memory
QDRANT_PATH=".qdrant"
QDRANT_URL="http://localhost:6333"
QDRANT_API_KEY=""
QDRANT_COLLECTION="document_intelligence"
QDRANT_TIMEOUT_SECONDS=10
EMBEDDING_MODEL="BAAI/bge-small-en-v1.5"

# Reranking and hybrid scoring (tune with `python -m app.evaluation.runner --sweep`)
RERANKER=cross-encoder
RERANKER_MODEL="cross-encoder/ms-marco-MiniLM-L-6-v2"
HYBRID_DENSE_WEIGHT=0.35
HYBRID_BM25_WEIGHT=0.35
HYBRID_LEXICAL_WEIGHT=0.30
RETRIEVAL_TOP_K=4
RETRIEVAL_CANDIDATE_K=20

# How many times an answer with unsupported claims may be regenerated
MAX_REGENERATIONS=1

# Answer greetings / general-knowledge questions directly (labelled as not based on your files)
ALLOW_GENERAL_ANSWERS=true
# Conversation memory: recent turns kept verbatim (older ones are summarised by the LLM); used for follow-up
# rewriting and by the general agent
GENERAL_HISTORY_TURNS=6

# Logging: DEBUG also shows a "Logs" panel in the sidebar. LOG_CONTENT=true adds questions/answers/document text
# to log lines (off by default; only lengths, file names, counts and scores are logged).
LOG_LEVEL=INFO
LOG_FORMAT=text
LOG_FILE=""
LOG_CONTENT=false
